# Lokale Worker-Secrets für `wrangler dev`.
# Kopieren nach `.dev.vars` (liegt in .gitignore) und Werte einsetzen.
# Produktion: dieselben Keys per `wrangler secret put …`

# --- Rezepte & Tagesvorschläge (Gemini) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   # nur Rezept-Erstellung: 2. Versuch nach 15 s bei Timeout/Überlast
# OPENROUTER_API_KEY=                  # für Rezept-Bilder (OpenRouter Images API)
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# --- Sprach-Dump in der Add-Bar (Groq) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_RPM=27

# --- Web Push (optional; ohne Keys ist Push deaktiviert) ---
# Schlüssel: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:du@example.com

# --- Magic-Link-Login per E-Mail (Resend, optional) ---
# Ohne RESEND_API_KEY ist der Magic-Link-Tab deaktiviert und meldet das klar.
# RESEND_FROM muss eine bei Resend verifizierte Domain nutzen.
# RESEND_API_KEY=
# RESEND_FROM="Buylist <noreply@deinedomain.de>"
# APP_URL=https://buylist.deinedomain.de   # optional; sonst Origin des Requests
